# ─── Backend ───────────────────────────────────────────────
# Port the CMS backend listens on.
PORT=5000

# ─── Frontend (optional) ───────────────────────────────────
# Override the API base URL the frontend talks to.
# Defaults to http://localhost:5000 in development.
# VITE_API_URL=http://localhost:5000

# ─── Manager login (optional) ──────────────────────────────
# JSON of {username, passwordHash} where passwordHash is SHA-256.
# Default credentials: admin / admin
# Generate a hash:  echo -n "yourpassword" | shasum -a 256
# VITE_ADMIN_CREDENTIALS={"username":"manager","passwordHash":"<sha256>"}
